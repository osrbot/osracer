          <geometry><box><size>7.0 0.08 0.30</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <collision name="west_collision">
          <pose>-3.5 0 0 0 0 0</pose>
          <geometry><box><size>0.08 4.5 0.30</size></box></geometry>
        </collision>
        <visual name="west_visual">
          <pose>-3.5 0 0 0 0 0</pose>
          <geometry><box><size>0.08 4.5 0.30</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <collision name="east_collision">
          <pose>3.5 0 0 0 0 0</pose>
          <geometry><box><size>0.08 4.5 0.30</size></box></geometry>
        </collision>
        <visual name="east_visual">
          <pose>3.5 0 0 0 0 0</pose>
          <geometry><box><size>0.08 4.5 0.30</size></box></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
