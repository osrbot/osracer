<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>osracer_demo</name>
  <version>0.1.0</version>
  <description>Field demo tools for OSRacer ROS 2 bringup and low-speed motion checks.</description>

  <maintainer email="kitso666@example.com">kitso666</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>ackermann_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>osracer_bringup</exec_depend>
  <exec_depend>osracer_debug</exec_depend>
  <exec_depend>osracer_navigation</exec_depend>
  <exec_depend>osracer_slam</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
